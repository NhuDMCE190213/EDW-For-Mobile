import 'package:flutter/material.dart';

import '../models/admin_user.dart';
import '../services/admin_user_api.dart';

class AdminUserManagementPage extends StatefulWidget {
  const AdminUserManagementPage({super.key, required this.api});

  final AdminUserApi api;

  @override
  AdminUserManagementPageState createState() => AdminUserManagementPageState();
}

class AdminUserManagementPageState extends State<AdminUserManagementPage> {
  int _tab = 0;
  List<AdminUser> _users = [];
  bool _loading = true;
  String? _error;

  @override
  void initState() {
    super.initState();
    _load();
  }

  Future<void> refresh() => _load();

  Future<void> _load() async {
    final tab = _tab;
    setState(() {
      _loading = true;
      _error = null;
    });
    try {
      final users = tab == 0
          ? await widget.api.getStaff()
          : await widget.api.getCustomers();
      if (!mounted) return;
      if (tab != _tab) return;
      setState(() {
        _users = users;
        _loading = false;
      });
    } catch (error) {
      if (!mounted) return;
      if (tab != _tab) return;
      setState(() {
        _error = error.toString();
        _loading = false;
      });
    }
  }

  Future<void> _create() async {
    final tab = _tab;
    final input = await showDialog<CreateAdminUserInput>(
      context: context,
      builder: (_) => _CreateUserDialog(isCustomer: tab == 1),
    );
    if (input == null) return;
    try {
      if (tab == 0) {
        await widget.api.createStaff(input);
      } else {
        await widget.api.createCustomer(input);
      }
      await _load();
      _message('${tab == 0 ? 'Staff' : 'Customer'} created.');
    } catch (error) {
      _message(error.toString(), error: true);
    }
  }

  Future<void> _toggle(AdminUser user) async {
    final tab = _tab;
    try {
      if (tab == 0) {
        await widget.api.setStaffActive(user.id, !user.isActive);
      } else {
        await widget.api.setCustomerActive(user.id, !user.isActive);
      }
      await _load();
      _message(user.isActive ? 'User disabled.' : 'User enabled.');
    } catch (error) {
      _message(error.toString(), error: true);
    }
  }

  void _message(String text, {bool error = false}) {
    if (!mounted) return;
    ScaffoldMessenger.of(context).showSnackBar(
      SnackBar(
        content: Text(text),
        backgroundColor: error ? Colors.red.shade700 : null,
      ),
    );
  }

  @override
  Widget build(BuildContext context) {
    return Padding(
      padding: const EdgeInsets.all(16),
      child: Column(
        children: [
          Row(
            children: [
              Expanded(
                child: SegmentedButton<int>(
                  segments: const [
                    ButtonSegment(
                      value: 0,
                      label: Text('Staff'),
                      icon: Icon(Icons.badge_outlined),
                    ),
                    ButtonSegment(
                      value: 1,
                      label: Text('Customers'),
                      icon: Icon(Icons.people_outline),
                    ),
                  ],
                  selected: {_tab},
                  onSelectionChanged: (selected) {
                    setState(() => _tab = selected.first);
                    _load();
                  },
                ),
              ),
              const SizedBox(width: 8),
              IconButton.filled(
                onPressed: _loading ? null : _load,
                icon: const Icon(Icons.refresh),
                tooltip: 'Refresh',
              ),
              const SizedBox(width: 8),
              FilledButton.icon(
                onPressed: _loading ? null : _create,
                icon: const Icon(Icons.add),
                label: Text(_tab == 0 ? 'Create staff' : 'Create customer'),
              ),
            ],
          ),
          const SizedBox(height: 16),
          Expanded(child: _buildContent()),
        ],
      ),
    );
  }

  Widget _buildContent() {
    if (_loading) return const Center(child: CircularProgressIndicator());
    if (_error != null) {
      return Center(
        child: Column(
          mainAxisSize: MainAxisSize.min,
          children: [
            Text(_error!, textAlign: TextAlign.center),
            const SizedBox(height: 12),
            OutlinedButton(onPressed: _load, child: const Text('Try again')),
          ],
        ),
      );
    }
    if (_users.isEmpty) return const Center(child: Text('No users found.'));
    return Card(
      clipBehavior: Clip.antiAlias,
      child: ListView.separated(
        itemCount: _users.length,
        separatorBuilder: (_, _) => const Divider(height: 1),
        itemBuilder: (_, index) {
          final user = _users[index];
          return ListTile(
            leading: CircleAvatar(
              child: Text(
                user.fullName.isEmpty ? '?' : user.fullName[0].toUpperCase(),
              ),
            ),
            title: Text(user.fullName.isEmpty ? '(No name)' : user.fullName),
            subtitle: Text(
              [
                user.email,
                if (user.phoneNumber?.isNotEmpty == true) user.phoneNumber!,
              ].join(' • '),
            ),
            trailing: Row(
              mainAxisSize: MainAxisSize.min,
              children: [
                Chip(
                  label: Text(user.isActive ? 'Active' : 'Disabled'),
                  avatar: Icon(
                    user.isActive ? Icons.check : Icons.block,
                    size: 16,
                  ),
                  backgroundColor: user.isActive
                      ? Colors.green.shade50
                      : Colors.grey.shade200,
                ),
                IconButton(
                  onPressed: () => _toggle(user),
                  icon: Icon(
                    user.isActive
                        ? Icons.person_off_outlined
                        : Icons.person_add_alt_1_outlined,
                  ),
                  tooltip: user.isActive ? 'Disable' : 'Enable',
                ),
              ],
            ),
          );
        },
      ),
    );
  }
}

class _CreateUserDialog extends StatefulWidget {
  const _CreateUserDialog({required this.isCustomer});

  final bool isCustomer;

  @override
  State<_CreateUserDialog> createState() => _CreateUserDialogState();
}

class _CreateUserDialogState extends State<_CreateUserDialog> {
  final _formKey = GlobalKey<FormState>();
  final _name = TextEditingController();
  final _email = TextEditingController();
  final _phone = TextEditingController();
  final _password = TextEditingController();

  @override
  void dispose() {
    _name.dispose();
    _email.dispose();
    _phone.dispose();
    _password.dispose();
    super.dispose();
  }

  void _submit() {
    if (!_formKey.currentState!.validate()) return;
    Navigator.pop(
      context,
      CreateAdminUserInput(
        fullName: _name.text.trim(),
        email: _email.text.trim(),
        password: _password.text,
        phoneNumber: widget.isCustomer ? _phone.text.trim() : null,
      ),
    );
  }

  @override
  Widget build(BuildContext context) => AlertDialog(
    title: Text(widget.isCustomer ? 'Create customer' : 'Create staff'),
    content: SizedBox(
      width: 420,
      child: Form(
        key: _formKey,
        child: SingleChildScrollView(
          child: Column(
            children: [
              _field(_name, 'Full name'),
              _field(
                _email,
                'Email',
                keyboard: TextInputType.emailAddress,
                validator: (value) {
                  if (value == null || value.trim().isEmpty) return 'Required';
                  return RegExp(r'^[^@\s]+@[^@\s]+\.[^@\s]+$')
                          .hasMatch(value.trim())
                      ? null
                      : 'Invalid email';
                },
              ),
              if (widget.isCustomer)
                _field(_phone, 'Phone number', keyboard: TextInputType.phone),
              _field(
                _password,
                'Password',
                obscure: true,
                validator: (value) {
                  if (value == null || value.isEmpty) return 'Required';
                  if (value.length < 8) return 'At least 8 characters';
                  if (!RegExp(r'[A-Za-z]').hasMatch(value) ||
                      !RegExp(r'\d').hasMatch(value) ||
                      !RegExp(r'''[!@#$%^&*()_+\-=\[\]{};':"\\|,.<>/?]''')
                          .hasMatch(value)) {
                    return 'Must contain a letter, number and symbol';
                  }
                  return null;
                },
              ),
            ],
          ),
        ),
      ),
    ),
    actions: [
      TextButton(
        onPressed: () => Navigator.pop(context),
        child: const Text('Cancel'),
      ),
      FilledButton(onPressed: _submit, child: const Text('Create')),
    ],
  );

  Widget _field(
    TextEditingController controller,
    String label, {
    bool required = true,
    bool obscure = false,
    TextInputType? keyboard,
    String? Function(String?)? validator,
  }) => Padding(
    padding: const EdgeInsets.only(bottom: 12),
    child: TextFormField(
      controller: controller,
      obscureText: obscure,
      keyboardType: keyboard,
      decoration: InputDecoration(
        labelText: label,
        border: const OutlineInputBorder(),
      ),
      validator:
          validator ??
          (required
              ? (value) =>
                    value == null || value.trim().isEmpty ? 'Required' : null
              : null),
    ),
  );
}
</file>

<file path="screens/customer_cart_page.dart">
import 'package:flutter/material.dart';

import '../models/cart_item.dart';
import '../services/cart_api.dart';
import '../services/order_api.dart';
import 'customer_orders_page.dart';

class CustomerCartPage extends StatefulWidget {
  const CustomerCartPage({
    super.key,
    required this.api,
    this.orderApi,
    required this.customerId,
  });

  final CartApi api;
  final OrderApi? orderApi;
  final int customerId;

  @override
  State<CustomerCartPage> createState() => _CustomerCartPageState();
}

class _CustomerCartPageState extends State<CustomerCartPage> {
  List<CartItem> _cartItems = [];
  final Set<int> _selectedItemIds = {};
  bool _isLoading = true;
  bool _isCheckingOut = false;
  final Set<int> _updatingItemIds = {};

  @override
  void initState() {
    super.initState();
    _fetchCart();
  }

  Future<void> _fetchCart() async {
    setState(() => _isLoading = true);
    try {
      final items = await widget.api.getCartItems(widget.customerId);
      setState(() {
        _cartItems = items;
        // By default select all items
        _selectedItemIds.clear();
        for (var item in items) {
          _selectedItemIds.add(item.cartItemId);
        }
        _isLoading = false;
      });
    } catch (e) {
      setState(() => _isLoading = false);
      if (mounted) {
        ScaffoldMessenger.of(context).showSnackBar(
          SnackBar(content: Text('Error loading cart: $e')),
        );
      }
    }
  }

  Future<void> _updateQuantity(CartItem item, int delta) async {
    final newQty = item.quantity + delta;
    if (newQty <= 0) {
      _confirmRemoveItem(item.cartItemId);
      return;
    }

    if (newQty > item.productVariant.stockQuantity) {
      ScaffoldMessenger.of(context).showSnackBar(
        SnackBar(
          content: Text(
            'Cannot add more. Only ${item.productVariant.stockQuantity} items in stock.',
          ),
          backgroundColor: Colors.orange,
        ),
      );
      return;
    }

    setState(() => _updatingItemIds.add(item.cartItemId));
    try {
      await widget.api.updateQuantity(
        item.cartItemId,
        newQty,
        widget.customerId,
      );
      await _fetchCart();
    } catch (e) {
      if (mounted) {
        ScaffoldMessenger.of(context).showSnackBar(
          SnackBar(content: Text('Error updating quantity: $e')),
        );
      }
    } finally {
      if (mounted) {
        setState(() => _updatingItemIds.remove(item.cartItemId));
      }
    }
  }

  void _confirmRemoveItem(int cartItemId) {
    showDialog(
      context: context,
      builder: (ctx) => AlertDialog(
        title: const Text('Remove item'),
        content: const Text('Are you sure you want to remove this item from your cart?'),
        actions: [
          TextButton(
            onPressed: () => Navigator.pop(ctx),
            child: const Text('Cancel'),
          ),
          FilledButton(
            onPressed: () {
              Navigator.pop(ctx);
              _removeItem(cartItemId);
            },
            style: FilledButton.styleFrom(
              backgroundColor: Colors.red,
            ),
            child: const Text('Remove'),
          ),
        ],
      ),
    );
  }

  Future<void> _removeItem(int cartItemId) async {
    try {
      await widget.api.removeFromCart(cartItemId, widget.customerId);
      _selectedItemIds.remove(cartItemId);
      await _fetchCart();
      if (mounted) {
        ScaffoldMessenger.of(context).showSnackBar(
          const SnackBar(content: Text('Item removed from cart')),
        );
      }
    } catch (e) {
      if (mounted) {
        ScaffoldMessenger.of(context).showSnackBar(
          SnackBar(content: Text('Error removing item: $e')),
        );
      }
    }
  }

  double _calculateSelectedTotal() {
    double total = 0;
    for (var item in _cartItems) {
      if (_selectedItemIds.contains(item.cartItemId)) {
        total += item.productVariant.price * item.quantity;
      }
    }
    return total;
  }

  Future<void> _handleCheckout() async {
    if (widget.orderApi == null) {
      ScaffoldMessenger.of(context).showSnackBar(
        const SnackBar(content: Text('Order service is unavailable')),
      );
      return;
    }

    if (_selectedItemIds.isEmpty) {
      ScaffoldMessenger.of(context).showSnackBar(
        const SnackBar(
          content: Text('Please select at least one item to checkout'),
          backgroundColor: Colors.orange,
        ),
      );
      return;
    }

    final total = _calculateSelectedTotal();

    final confirm = await showDialog<bool>(
      context: context,
      builder: (ctx) => AlertDialog(
        title: const Row(
          children: [
            Icon(Icons.shopping_bag_outlined, color: Color(0xFFE24B4A)),
            SizedBox(width: 8),
            Text('Confirm Checkout'),
          ],
        ),
        content: Column(
          mainAxisSize: MainAxisSize.min,
          crossAxisAlignment: CrossAxisAlignment.start,
          children: [
            Text('Selected Items: ${_selectedItemIds.length}'),
            const SizedBox(height: 8),
            Text(
              'Total Amount: \$${total.toStringAsFixed(2)}',
              style: const TextStyle(
                fontWeight: FontWeight.bold,
                fontSize: 16,
                color: Color(0xFFE24B4A),
              ),
            ),
            const SizedBox(height: 12),
            const Text(
              'Would you like to place this order now?',
              style: TextStyle(color: Colors.grey),
            ),
          ],
        ),
        actions: [
          TextButton(
            onPressed: () => Navigator.pop(ctx, false),
            child: const Text('Cancel'),
          ),
          FilledButton(
            onPressed: () => Navigator.pop(ctx, true),
            style: FilledButton.styleFrom(
              backgroundColor: const Color(0xFFE24B4A),
            ),
            child: const Text('Place Order'),
          ),
        ],
      ),
    );

    if (confirm != true || !mounted) return;

    setState(() => _isCheckingOut = true);
    try {
      final result = await widget.orderApi!.checkoutCart(
        widget.customerId,
        _selectedItemIds.toList(),
      );

      if (!mounted) return;
      setState(() => _isCheckingOut = false);

      // Show Checkout Success Dialog
      await showDialog(
        context: context,
        barrierDismissible: false,
        builder: (ctx) => AlertDialog(
          icon: const Icon(
            Icons.check_circle,
            color: Colors.green,
            size: 56,
          ),
          title: const Text('Checkout Successful!'),
          content: Column(
            mainAxisSize: MainAxisSize.min,
            crossAxisAlignment: CrossAxisAlignment.start,
            children: [
              Text(
                'Order ID: #${result.order.orderId.length > 8 ? result.order.orderId.substring(0, 8) : result.order.orderId}',
                style: const TextStyle(fontWeight: FontWeight.bold),
              ),
              const SizedBox(height: 6),
              Text('Subtotal: \$${result.subtotal.toStringAsFixed(2)}'),
              if (result.discount > 0)
                Text(
                  'Discount: -\$${result.discount.toStringAsFixed(2)}',
                  style: const TextStyle(color: Colors.green),
                ),
              Text('Shipping: \$${result.shipping.toStringAsFixed(2)}'),
              const Divider(),
              Text(
                'Total Paid: \$${result.total.toStringAsFixed(2)}',
                style: const TextStyle(
                  fontWeight: FontWeight.bold,
                  fontSize: 18,
                  color: Color(0xFFE24B4A),
                ),
              ),
              const SizedBox(height: 8),
              Container(
                padding: const EdgeInsets.symmetric(horizontal: 10, vertical: 4),
                decoration: BoxDecoration(
                  color: Colors.orange.shade50,
                  borderRadius: BorderRadius.circular(8),
                  border: Border.all(color: Colors.orange.shade200),
                ),
                child: Text(
                  'Status: ${result.order.status}',
                  style: TextStyle(
                    color: Colors.orange.shade800,
                    fontWeight: FontWeight.w600,
                    fontSize: 12,
                  ),
                ),
              ),
            ],
          ),
          actions: [
            TextButton(
              onPressed: () {
                Navigator.pop(ctx);
                _fetchCart();
              },
              child: const Text('Continue Shopping'),
            ),
            FilledButton.icon(
              onPressed: () {
                Navigator.pop(ctx);
                Navigator.pushReplacement(
                  context,
                  MaterialPageRoute(
                    builder: (_) => CustomerOrdersPage(
                      api: widget.orderApi!,
                      customerId: widget.customerId,
                    ),
                  ),
                );
              },
              icon: const Icon(Icons.receipt_long),
              label: const Text('View Orders'),
              style: FilledButton.styleFrom(
                backgroundColor: const Color(0xFFE24B4A),
              ),
            ),
          ],
        ),
      );

      _fetchCart();
    } catch (e) {
      setState(() => _isCheckingOut = false);
      if (mounted) {
        ScaffoldMessenger.of(context).showSnackBar(
          SnackBar(
            content: Text('Checkout failed: $e'),
            backgroundColor: Colors.red,
          ),
        );
      }
    }
  }

  @override
  Widget build(BuildContext context) {
    final allSelected = _cartItems.isNotEmpty &&
        _selectedItemIds.length == _cartItems.length;
    final selectedTotal = _calculateSelectedTotal();

    return Scaffold(
      appBar: AppBar(
        title: const Text('My Cart'),
        actions: [
          if (_cartItems.isNotEmpty)
            TextButton.icon(
              onPressed: () {
                setState(() {
                  if (allSelected) {
                    _selectedItemIds.clear();
                  } else {
                    _selectedItemIds.clear();
                    for (var i in _cartItems) {
                      _selectedItemIds.add(i.cartItemId);
                    }
                  }
                });
              },
              icon: Icon(
                allSelected ? Icons.check_box : Icons.check_box_outline_blank,
                size: 20,
              ),
              label: Text(allSelected ? 'Deselect All' : 'Select All'),
            ),
        ],
      ),
      body: _isLoading
          ? const Center(child: CircularProgressIndicator())
          : _cartItems.isEmpty
          ? Center(
              child: Column(
                mainAxisAlignment: MainAxisAlignment.center,
                children: [
                  Icon(
                    Icons.remove_shopping_cart_outlined,
                    size: 80,
                    color: Colors.grey.shade400,
                  ),
                  const SizedBox(height: 16),
                  const Text(
                    'Your cart is empty',
                    style: TextStyle(fontSize: 18, fontWeight: FontWeight.bold),
                  ),
                  const SizedBox(height: 8),
                  Text(
                    'Browse items and add them to your cart!',
                    style: TextStyle(color: Colors.grey.shade600),
                  ),
                ],
              ),
            )
          : RefreshIndicator(
              onRefresh: _fetchCart,
              child: ListView.builder(
                padding: const EdgeInsets.only(bottom: 100),
                itemCount: _cartItems.length,
                itemBuilder: (context, index) {
                  final item = _cartItems[index];
                  final isSelected = _selectedItemIds.contains(item.cartItemId);
                  final isUpdating = _updatingItemIds.contains(item.cartItemId);

                  final variant = item.productVariant;
                  final specText = [
                    if (variant.ram != null && variant.ram!.isNotEmpty)
                      '${variant.ram} RAM',
                    if (variant.storage != null && variant.storage!.isNotEmpty)
                      variant.storage,
                    if (variant.color.isNotEmpty) variant.color,
                  ].join(' • ');

                  return Card(
                    margin: const EdgeInsets.symmetric(
                      horizontal: 16,
                      vertical: 6,
                    ),
                    elevation: 1,
                    shape: RoundedRectangleBorder(
                      borderRadius: BorderRadius.circular(12),
                      side: BorderSide(
                        color: isSelected
                            ? Theme.of(context).colorScheme.primary.withValues(alpha: 0.5)
                            : Colors.grey.shade200,
                        width: isSelected ? 1.5 : 1,
                      ),
                    ),
                    child: Padding(
                      padding: const EdgeInsets.all(12),
                      child: Row(
                        crossAxisAlignment: CrossAxisAlignment.start,
                        children: [
                          Checkbox(
                            value: isSelected,
                            onChanged: (val) {
                              setState(() {
                                if (val == true) {
                                  _selectedItemIds.add(item.cartItemId);
                                } else {
                                  _selectedItemIds.remove(item.cartItemId);
                                }
                              });
                            },
                          ),
                          ClipRRect(
                            borderRadius: BorderRadius.circular(8),
                            child: variant.imageUrl != null &&
                                    variant.imageUrl!.isNotEmpty
                                ? Image.network(
                                    variant.imageUrl!,
                                    width: 68,
                                    height: 68,
                                    fit: BoxFit.cover,
                                    errorBuilder: (_, _, _) => Container(
                                      width: 68,
                                      height: 68,
                                      color: Colors.grey.shade200,
                                      child: const Icon(Icons.devices, size: 30),
                                    ),
                                  )
                                : Container(
                                    width: 68,
                                    height: 68,
                                    color: Colors.grey.shade200,
                                    child: const Icon(Icons.devices, size: 30),
                                  ),
                          ),
                          const SizedBox(width: 12),
                          Expanded(
                            child: Column(
                              crossAxisAlignment: CrossAxisAlignment.start,
                              children: [
                                Text(
                                  variant.sku.isNotEmpty
                                      ? variant.sku
                                      : 'Variant ${variant.id.substring(0, 8)}',
                                  style: const TextStyle(
                                    fontWeight: FontWeight.bold,
                                    fontSize: 15,
                                  ),
                                ),
                                if (specText.isNotEmpty) ...[
                                  const SizedBox(height: 2),
                                  Text(
                                    specText,
                                    style: TextStyle(
                                      color: Colors.grey.shade600,
                                      fontSize: 12,
                                    ),
                                  ),
                                ],
                                const SizedBox(height: 6),
                                Text(
                                  '\$${variant.price.toStringAsFixed(2)}',
                                  style: TextStyle(
                                    color: Theme.of(context).colorScheme.primary,
                                    fontWeight: FontWeight.bold,
                                    fontSize: 15,
                                  ),
                                ),
                                const SizedBox(height: 8),
                                Row(
                                  mainAxisAlignment:
                                      MainAxisAlignment.spaceBetween,
                                  children: [
                                    // Quantity selector
                                    Container(
                                      decoration: BoxDecoration(
                                        border: Border.all(
                                          color: Colors.grey.shade300,
                                        ),
                                        borderRadius: BorderRadius.circular(8),
                                      ),
                                      child: Row(
                                        mainAxisSize: MainAxisSize.min,
                                        children: [
                                          InkWell(
                                            onTap: isUpdating
                                                ? null
                                                : () =>
                                                    _updateQuantity(item, -1),
                                            borderRadius:
                                                const BorderRadius.horizontal(
                                              left: Radius.circular(8),
                                            ),
                                            child: const Padding(
                                              padding: EdgeInsets.symmetric(
                                                horizontal: 8,
                                                vertical: 4,
                                              ),
                                              child: Icon(Icons.remove, size: 18),
                                            ),
                                          ),
                                          Padding(
                                            padding: const EdgeInsets.symmetric(
                                              horizontal: 8,
                                            ),
                                            child: isUpdating
                                                ? const SizedBox(
                                                    width: 14,
                                                    height: 14,
                                                    child:
                                                        CircularProgressIndicator(
                                                      strokeWidth: 2,
                                                    ),
                                                  )
                                                : Text(
                                                    '${item.quantity}',
                                                    style: const TextStyle(
                                                      fontWeight:
                                                          FontWeight.bold,
                                                    ),
                                                  ),
                                          ),
                                          InkWell(
                                            onTap: isUpdating
                                                ? null
                                                : () =>
                                                    _updateQuantity(item, 1),
                                            borderRadius:
                                                const BorderRadius.horizontal(
                                              right: Radius.circular(8),
                                            ),
                                            child: const Padding(
                                              padding: EdgeInsets.symmetric(
                                                horizontal: 8,
                                                vertical: 4,
                                              ),
                                              child: Icon(Icons.add, size: 18),
                                            ),
                                          ),
                                        ],
                                      ),
                                    ),
                                    // Remove button
                                    IconButton(
                                      icon: const Icon(
                                        Icons.delete_outline,
                                        color: Colors.red,
                                        size: 20,
                                      ),
                                      onPressed: () =>
                                          _confirmRemoveItem(item.cartItemId),
                                      tooltip: 'Remove',
                                    ),
                                  ],
                                ),
                              ],
                            ),
                          ),
                        ],
                      ),
                    ),
                  );
                },
              ),
            ),
      bottomSheet: _cartItems.isEmpty
          ? null
          : Container(
              padding: const EdgeInsets.all(16),
              decoration: BoxDecoration(
                color: Colors.white,
                boxShadow: [
                  BoxShadow(
                    color: Colors.black.withValues(alpha: 0.08),
                    blurRadius: 10,
                    offset: const Offset(0, -3),
                  ),
                ],
              ),
              child: SafeArea(
                child: Row(
                  children: [
                    Column(
                      mainAxisSize: MainAxisSize.min,
                      crossAxisAlignment: CrossAxisAlignment.start,
                      children: [
                        Text(
                          'Selected (${_selectedItemIds.length})',
                          style: TextStyle(
                            color: Colors.grey.shade600,
                            fontSize: 12,
                          ),
                        ),
                        Text(
                          '\$${selectedTotal.toStringAsFixed(2)}',
                          style: const TextStyle(
                            fontSize: 20,
                            fontWeight: FontWeight.bold,
                            color: Color(0xFFE24B4A),
                          ),
                        ),
                      ],
                    ),
                    const Spacer(),
                    FilledButton.icon(
                      onPressed: _isCheckingOut || _selectedItemIds.isEmpty
                          ? null
                          : _handleCheckout,
                      style: FilledButton.styleFrom(
                        backgroundColor: const Color(0xFFE24B4A),
                        padding: const EdgeInsets.symmetric(
                          horizontal: 24,
                          vertical: 14,
                        ),
                        shape: RoundedRectangleBorder(
                          borderRadius: BorderRadius.circular(12),
                        ),
                      ),
                      icon: _isCheckingOut
                          ? const SizedBox(
                              width: 18,
                              height: 18,
                              child: CircularProgressIndicator(
                                color: Colors.white,
                                strokeWidth: 2,
                              ),
                            )
                          : const Icon(Icons.shopping_cart_checkout),
                      label: Text(
                        _isCheckingOut ? 'Processing...' : 'Checkout',
                        style: const TextStyle(
                          fontSize: 16,
                          fontWeight: FontWeight.bold,
                        ),
                      ),
                    ),
                  ],
                ),
              ),
            ),
    );
  }
}
