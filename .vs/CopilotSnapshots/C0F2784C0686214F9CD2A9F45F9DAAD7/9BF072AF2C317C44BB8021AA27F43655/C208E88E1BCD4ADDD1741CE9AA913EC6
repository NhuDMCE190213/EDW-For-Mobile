<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - FoodHub Staff Portal</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/UserStaff.Razor.styles.css" asp-append-version="true" />

    <style>
        /* Khóa cứng màu đỏ CellphoneS */
        .bg-cellphone {
            background-color: #d70018 !important;
        }

        .text-cellphone {
            color: #d70018 !important;
        }
        /* Custom thanh điều hướng */
        .nav-link-custom {
            color: rgba(255, 255, 255, 0.85) !important;
            font-weight: 500;
            padding: 8px 16px !important;
            border-radius: 6px;
            transition: all 0.2s ease-in-out;
        }

            .nav-link-custom:hover {
                background-color: rgba(255, 255, 255, 0.15);
                color: #ffffff !important;
            }
        /* Làm nổi bật phân hệ Cấu hình hệ thống (Bảng của bạn) */
        .nav-link-special {
            background-color: rgba(255, 255, 255, 0.2);
            color: #ffffff !important;
            font-weight: 600;
        }

            .nav-link-special:hover {
                background-color: rgba(255, 255, 255, 0.3) !important;
            }
        /* Định dạng lại dropdown tài khoản */
        .dropdown-menu-custom {
            border: none;
            box-shadow: 0 10px 30px rgba(0,0,0,0.075);
            border-radius: 8px;
        }

        .dropdown-item-custom:hover {
            background-color: #f8f9fa;
            color: #d70018;
        }
    </style>
</head>
<body class="bg-light d-flex flex-column min-vh-100">
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-cellphone border-bottom shadow-sm py-2">
            <div class="container-fluid px-4">
                <a class="navbar-brand fw-bold text-white d-flex align-items-center fs-4" asp-area="" asp-page="/Index">
                    <i class="bi bi-fire me-2"></i> FoodHub Staff
                </a>

                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-collapse collapse d-lg-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1 ms-lg-3 gap-1 my-2 my-lg-0">
                        <li class="nav-item">
                            <a class="nav-link nav-link-custom" asp-area="" asp-page="/Dashboard">
                                <i class="bi bi-graph-up-arrow me-1"></i> Tổng quan
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link nav-link-custom" asp-area="" asp-page="/Orders/Index">
                                <i class="bi bi-cart-check-fill me-1"></i> Đơn hàng
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link nav-link-custom" asp-area="" asp-page="/Products/Index">
                                <i class="bi bi-box-seam-fill me-1"></i> Sản phẩm & Kho
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link nav-link-custom nav-link-special" asp-area="" asp-page="/Settings/Index">
                                <i class="bi bi-sliders me-1"></i> Cấu hình hệ thống
                            </a>
                        </li>
                    </ul>

                    <div class="d-flex align-items-center gap-3">
                        <span class="badge bg-white text-danger px-3 py-2 fw-semibold shadow-sm">
                            <i class="bi bi-person-badge-fill me-1"></i> Staff Mode
                        </span>

                        <div class="dropdown">
                            <a class="btn btn-link text-white text-decoration-none dropdown-toggle fw-medium d-flex align-items-center p-0"
                               href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-person-circle fs-5 me-1"></i> Nguyễn Văn A
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end dropdown-menu-custom border-0 mt-2">
                                <li>
                                    <a class="dropdown-item dropdown-item-custom py-2" href="#">
                                        <i class="bi bi-person me-2"></i> Hồ sơ cá nhân
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider m-1"></li>
                                <li>
                                    <a class="dropdown-item dropdown-item-custom py-2 text-danger" href="#">
                                        <i class="bi bi-box-arrow-right me-2"></i> Đăng xuất
                                    </a>
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="container-fluid px-4 my-4">
        <main role="main" class="bg-white p-4 rounded shadow-sm">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted bg-white py-3 mt-auto shadow-sm">
        <div class="container-fluid px-4 d-flex flex-column flex-sm-row justify-content-between align-items-center gap-2 small">
            <span>&copy; 2026 - <b class="text-cellphone">FoodHub Management Portal</b> - Hệ thống vận hành nội bộ</span>
            <span class="text-muted">Giao diện phân quyền: <b class="text-danger">Nhân viên / Quản lý</b></span>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>