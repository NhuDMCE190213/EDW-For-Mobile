@page
@model UserStaff.Razor.Pages.ProductVariants.IndexModel
@{
    ViewData["Title"] = "Quản lý biến thể sản phẩm";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="m-0 fw-bold border-start border-4 ps-3 border-danger">Danh sách Biến thể (Variants)</h2>
    <a asp-page="Create" class="btn btn-danger px-4 shadow-sm">
        <i class="bi bi-plus-circle me-2"></i>Thêm biến thể
    </a>
</div>

<div class="card shadow-sm border-0 rounded-3">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover table-borderless align-middle mb-0">
                <thead class="table-light border-bottom">
                    <tr>
                        <th class="py-3 px-4">SKU / ID</th>
                        <th>Cấu hình cơ bản</th>
                        <th>Thông số kỹ thuật</th>
                        <th class="text-end">Giá bán (VNĐ)</th>
                        <th class="text-center">Tồn kho</th>
                        <th class="text-center px-4">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.ProductVariants.Count == 0)
                    {
                        <tr><td colspan="6" class="text-center py-4 text-muted">Chưa có dữ liệu biến thể.</td></tr>
                    }
                    @foreach (var variant in Model.ProductVariants)
                    {
                        <tr class="border-bottom">
                            <td class="px-4">
                                <div class="fw-bold text-dark">@variant.ProductCode</div>
                                <div class="text-muted small">SKU: @variant.Sku | ID: @variant.ProductId</div>
                            </td>
                            <td>
                                <span class="badge bg-secondary me-1">@variant.Color</span>
                                <span class="badge bg-info text-dark">@variant.Storage</span>
                            </td>
                            <td>
                                <div class="small">
                                    @if(!string.IsNullOrEmpty(variant.Ram)){ <span class="d-block"><b>RAM:</b> @variant.Ram</span> }
                                    @if(!string.IsNullOrEmpty(variant.Cpu)){ <span class="d-block"><b>CPU:</b> @variant.Cpu</span> }
                                </div>
                            </td>
                            <td class="text-end fw-bold text-danger">@variant.Price.ToString("N0") đ</td>
                            <td class="text-center">
                                @if (variant.StockQuantity > 10) {
                                    <span class="badge bg-success rounded-pill px-3">@variant.StockQuantity</span>
                                } else if (variant.StockQuantity > 0) {
                                    <span class="badge bg-warning text-dark rounded-pill px-3">@variant.StockQuantity</span>
                                } else {
                                    <span class="badge bg-danger rounded-pill px-3">Hết hàng</span>
                                }
                            </td>
                            <td class="text-center px-4">
                                <a asp-page="./Update" asp-route-id="@variant.ProductVariantId" class="btn btn-outline-primary btn-sm rounded-circle px-2" title="Chỉnh sửa">
                                    <i class="bi bi-pencil-square"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
